<Project>

  <!--
    Versión única de la solución (SemVer).
    Fuente de verdad del número: este archivo. Al publicar un release, el tag
    vX.Y.Z de GitHub debe coincidir con este valor.
    El SDK deriva de aquí el AssemblyVersion (0.1.0.0) y conserva el sufijo en
    el InformationalVersion (0.1.0-dev.0), que es lo que muestra la app.
  -->
  <PropertyGroup>
    <Version>0.1.1-dev.0</Version>
  </PropertyGroup>

</Project>
