<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RealFenixFailures.Application\RealFenixFailures.Application.csproj" />
    <ProjectReference Include="..\RealFenixFailures.Domain\RealFenixFailures.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <!-- Fuente única del wrapper managed: libs\ si existe, si no la del SDK.
       Usada por la referencia (HintPath) y por el None que la copia a la
       salida y a la carpeta de publish. -->
  <PropertyGroup>
    <SimConnectManagedDll>libs\Microsoft.FlightSimulator.SimConnect.dll</SimConnectManagedDll>
    <SimConnectManagedDll Condition="!Exists('libs\Microsoft.FlightSimulator.SimConnect.dll')">..\..\..\..\..\..\..\..\..\..\MSFS 2024 SDK\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</SimConnectManagedDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- Una sola referencia activa: usa $(SimConnectManagedDll) (libs\ si
         existe, si no el SDK). Private=False evita que RAR la copie por su
         cuenta; la copia la hace el None de abajo. -->
    <Reference Include="Microsoft.FlightSimulator.SimConnect" Condition="Exists('$(SimConnectManagedDll)')">
      <HintPath>$(SimConnectManagedDll)</HintPath>
      <Private>False</Private>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- El wrapper managed vive fuera del proyecto: un None Update no lo
         alcanza, hace falta Include con Link. Los items None viajan como
         archivos sueltos a la salida y a la carpeta de publish; con
         ExcludeFromSingleFile no se empaquetan dentro del exe único. -->
    <None Include="$(SimConnectManagedDll)"
          Link="Microsoft.FlightSimulator.SimConnect.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true"
          Condition="Exists('$(SimConnectManagedDll)')" />
    <None Update="SimConnect.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>