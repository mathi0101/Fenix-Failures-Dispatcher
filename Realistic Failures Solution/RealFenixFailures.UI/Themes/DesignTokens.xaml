<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background Colors -->
    <Color x:Key="Color.Background.Deep">#0D0F14</Color>
    <Color x:Key="Color.Background.Card">#13161E</Color>
    <Color x:Key="Color.Background.Glass.Card">#6613161E</Color>
    <Color x:Key="Color.Background.Glass.Inner">#8C0D0F14</Color>
    <Color x:Key="Color.Background.Card.Hover">#1A1E28</Color>
    <Color x:Key="Color.Background.TitleBar">#0A0C10</Color>
    <Color x:Key="Color.Background.StatusBar">#0F1117</Color>
    <Color x:Key="Color.Background.LogArea">#0A0C10</Color>
    <Color x:Key="Color.Background.Scenario.Selected">#1A2540</Color>
    <Color x:Key="Color.Background.Scenario.Default">#0D0F14</Color>
    <Color x:Key="Color.Background.Warning">#2A1C0A</Color>

    <!-- Accent Colors -->
    <Color x:Key="Color.Accent.Blue.Primary">#3B82F6</Color>
    <Color x:Key="Color.Accent.Blue.Dark">#2563EB</Color>
    <Color x:Key="Color.Accent.Blue.Darker">#1D4ED8</Color>
    <Color x:Key="Color.Accent.Green.Primary">#22C55E</Color>
    <Color x:Key="Color.Accent.Green.Dark">#14532D</Color>
    <Color x:Key="Color.Accent.Amber.Primary">#F59E0B</Color>
    <Color x:Key="Color.Accent.Orange.Primary">#F97316</Color>
    <Color x:Key="Color.Accent.Red.Primary">#EF4444</Color>
    <Color x:Key="Color.Accent.Red.Dark">#7F1D1D</Color>

    <!-- Text Colors -->
    <Color x:Key="Color.Text.Primary">#F1F5F9</Color>
    <Color x:Key="Color.Text.Secondary">#64748B</Color>
    <Color x:Key="Color.Text.Disabled">#1E2433</Color>

    <!-- Border Colors -->
    <Color x:Key="Color.Border.Default">#1E2433</Color>
    <Color x:Key="Color.Border.Warning">#F59E0B</Color>

    <!-- Icon Background Colors -->
    <Color x:Key="Color.Icon.Background.Plane">#2A1C1C</Color>
    <Color x:Key="Color.Icon.Background.Training">#1C2A3A</Color>
    <Color x:Key="Color.Icon.Background.Settings">#1C2A1C</Color>

</ResourceDictionary>