<Window x:Class="RealFenixFailures.UI.Views.RealisticRiskProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perfil de riesgo"
        Width="660" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#13161E"
        Loaded="OnLoaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Medidor fino del mock: pista redondeada con relleno proporcionado. -->
        <Style x:Key="ProfileMeterStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Height="5">
                            <Border x:Name="PART_Track" Background="#1B222F" CornerRadius="3">
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Background}"
                                        CornerRadius="3" HorizontalAlignment="Left"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D1017" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1"
                Padding="16,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Perfil de riesgo" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                <Button Content="✕" Width="30" Height="30" Click="Close_Click" HorizontalAlignment="Right"
                        Style="{StaticResource GhostButtonStyle}" FontSize="12" Padding="0"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="16,14,16,0">
            <TextBlock Text="Define la intensidad de las fallas de la sesión: con qué frecuencia aparecen, qué tan graves son y cuánto influye el desgaste de tu aeronave."
                       FontSize="12.5" LineHeight="19" Foreground="{StaticResource Brush.Text.Secondary}"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="Profiles" IsChecked="{Binding IsSelected, Mode=TwoWay}" Cursor="Hand"
                                     Margin="0,0,0,8" Focusable="True">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Card" Background="#0A0C10" BorderThickness="1" CornerRadius="8"
                                            BorderBrush="{Binding CardBorder}" Padding="0">
                                        <StackPanel>
                                            <!-- Encabezado: punto de color, nombre + descripción + estimación, píldora VATSIM e intensidad. -->
                                            <Grid Margin="14,11" >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="11" Height="11" Margin="0,0,12,0"
                                                         Fill="{Binding Accent}" VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold"
                                                               Foreground="{StaticResource Brush.Text.Primary}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" LineHeight="17"
                                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                                               TextWrapping="Wrap" Margin="0,1,8,0"/>
                                                    <TextBlock Text="{Binding EstimateDisplay}" FontSize="11.5" Margin="0,5,0,0"
                                                               Foreground="{StaticResource Brush.Text.Secondary}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{Binding VatsimPillBackground}" CornerRadius="5"
                                                        Padding="8,3" Margin="0,2,10,0" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding VatsimPill}" FontSize="10.5"
                                                               Foreground="{Binding VatsimPillForeground}"/>
                                                </Border>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,7,0,0">
                                                    <Border Width="14" Height="6" CornerRadius="3" Margin="0,0,3,0" Background="{Binding Intensity[0].Fill}"/>
                                                    <Border Width="14" Height="6" CornerRadius="3" Margin="0,0,3,0" Background="{Binding Intensity[1].Fill}"/>
                                                    <Border Width="14" Height="6" CornerRadius="3" Margin="0,0,3,0" Background="{Binding Intensity[2].Fill}"/>
                                                    <Border Width="14" Height="6" CornerRadius="3" Background="{Binding Intensity[3].Fill}"/>
                                                </StackPanel>
                                            </Grid>
                                            <!-- Detalle: solo cuando la tarjeta está seleccionada. -->
                                            <StackPanel Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                        Margin="14,0,14,12">
                                                <Border BorderBrush="#1A2029" BorderThickness="0,1,0,0" Padding="0,11,0,0">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,9">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="168"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Frecuencia de fallas" FontSize="12"
                                                                       Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ProgressBar Style="{StaticResource ProfileMeterStyle}" Value="{Binding FrequencyBar, Mode=OneWay}"
                                                                             Background="{Binding Accent}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding FrequencyLabel}" FontSize="11.5"
                                                                           FontFamily="Cascadia Mono" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource Brush.Text.Primary}"/>
                                                            </Grid>
                                                        </Grid>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="168"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Efecto del desgaste" FontSize="12"
                                                                       Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ProgressBar Style="{StaticResource ProfileMeterStyle}" Value="{Binding WearBar, Mode=OneWay}"
                                                                             Background="{Binding Accent}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding WearLabel}" FontSize="11.5"
                                                                           FontFamily="Cascadia Mono" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource Brush.Text.Primary}"/>
                                                            </Grid>
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding Chips}" Margin="0,10,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#0D1017" BorderBrush="#232A38" BorderThickness="1"
                                                                            CornerRadius="5" Padding="8,3" Margin="0,0,6,6">
                                                                        <TextBlock FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}">
                                                                            <Run FontWeight="SemiBold" Text="{Binding Lead, Mode=OneWay}"/>
                                                                            <Run Text="{Binding Rest, Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding EstimateFootNote}" FontSize="11" LineHeight="16" TextWrapping="Wrap"
                       Foreground="#6B7488" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#0D1017" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0"
                Padding="16,12" Margin="0,12,0,0">
            <Grid>
                <TextBlock Text="{Binding FootNote}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}"
                           VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Height="32" Padding="16,0" Margin="0,0,8,0" Click="Close_Click"
                            Style="{StaticResource GhostButtonStyle}" FontSize="12.5"/>
                    <Button x:Name="ConfirmButton" Content="Confirmar perfil" Height="32" Padding="16,0"
                            IsEnabled="{Binding CanConfirm}" Click="ConfirmProfile_Click"
                            Style="{StaticResource PrimaryButtonStyle}" FontSize="12.5"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
