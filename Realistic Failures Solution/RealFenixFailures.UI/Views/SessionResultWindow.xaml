<Window x:Class="RealFenixFailures.UI.Views.SessionResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rvm="clr-namespace:RealFenixFailures.UI.ViewModels.Realistic"
        Title="Resultados de la sesión"
        Width="880" Height="640"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#0D0F14" ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=rvm:SessionResultWindowViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Píldoras de estado/severidad (misma paleta que el mock) -->
        <Style x:Key="Chip" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="ChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F5B741"/>
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#0D0F14"/>
            <Setter Property="BorderBrush" Value="#1E2433"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2A2F3A" BorderThickness="1" CornerRadius="10" Background="#13161E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#0A0C10" BorderBrush="#1E2433" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Resultados de la sesión" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9"
                               Margin="16,10"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            Background="Transparent" BorderThickness="0" Foreground="#64748B"
                            Content="✕" Cursor="Hand" Click="Close_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,4,16,4">
                <StackPanel>

                    <!-- Cabecera de la sesión -->
                    <StackPanel Margin="0,12,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="#F1F5F9">
                                <Run Text="{Binding RouteDisplay, Mode=OneWay}"/>
                            </TextBlock>
                            <Border Background="#1A2540" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4"
                                    Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RiskLevelDisplay}" FontFamily="Consolas" FontSize="10"
                                           FontWeight="Bold" Foreground="#3B82F6"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding RegistrationDisplay}" FontSize="12" Foreground="#9BA3B0" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding StartedDisplay}" FontSize="12" Foreground="#9BA3B0" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding FinishedDisplay}" FontSize="12" Foreground="#9BA3B0" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding DurationDisplay}" FontSize="12" Foreground="#9BA3B0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Resumen -->
                    <TextBlock Text="RESUMEN" Style="{StaticResource SectionTitle}" Margin="0,14,0,8"/>
                    <UniformGrid Columns="6">
                        <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalFailures}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#F1F5F9"/>
                                <TextBlock Text="Fallas lanzadas" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ResolvedByPilot}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#22C55E"/>
                                <TextBlock Text="Por el piloto" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding AutoResolved}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#22C55E"/>
                                <TextBlock Text="Auto-resueltas" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding NotResolvedCount}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#EF4444"/>
                                <TextBlock Text="No resueltas (cierre)" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Rejected}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#F5B741"/>
                                <TextBlock Text="Rechazadas" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}">
                            <StackPanel>
                                <TextBlock Text="{Binding ActiveAtEnd}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#3B82F6"/>
                                <TextBlock Text="Activas al cierre" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Severidad:" FontSize="11" Foreground="#64748B" Margin="0,0,8,0"/>
                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#F5B741" Margin="0,0,14,0">
                            <Run Text="{Binding MinorCount, Mode=OneWay}"/><Run Text=" Minor"/>
                        </TextBlock>
                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#F97316" Margin="0,0,14,0">
                            <Run Text="{Binding MajorCount, Mode=OneWay}"/><Run Text=" Major"/>
                        </TextBlock>
                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#EF4444">
                            <Run Text="{Binding CriticalCount, Mode=OneWay}"/><Run Text=" Critical"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Cronología -->
                    <TextBlock Text="CRONOLOGÍA DE LA SESIÓN" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                    <Border Background="#0D0F14" BorderBrush="#1E2433" BorderThickness="1" CornerRadius="8"
                            Padding="6,8">
                        <ItemsControl ItemsSource="{Binding Timeline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}" FontFamily="Consolas"
                                                   FontSize="11" Foreground="#64748B" TextAlignment="Right" Margin="0,0,10,0"/>
                                        <Ellipse Grid.Column="1" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#3B82F6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Trigger">
                                                            <Setter Property="Fill" Value="#F97316"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Good">
                                                            <Setter Property="Fill" Value="#22C55E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Bad">
                                                            <Setter Property="Fill" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Muted">
                                                            <Setter Property="Fill" Value="#64748B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding EventCode}" FontFamily="Consolas" FontSize="10" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#3B82F6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Trigger">
                                                                <Setter Property="Foreground" Value="#F97316"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Good">
                                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Bad">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Muted">
                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#F1F5F9"/>
                                            <TextBlock Text="{Binding PhaseName, StringFormat= · {0}}" FontSize="11" Foreground="#64748B" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Fallas lanzadas -->
                    <TextBlock Text="FALLAS LANZADAS" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                    <ItemsControl ItemsSource="{Binding Failures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0D0F14" BorderBrush="#1E2433" BorderThickness="1" CornerRadius="8"
                                        Padding="12,9" Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnresolved}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#7F1D1D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                            <TextBlock Text="{Binding Detail}" FontFamily="Consolas" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Visibility="{Binding ShowSeverity, Converter={StaticResource BoolToVis}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                        <Setter Property="Padding" Value="7,2"/>
                                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Background" Value="#26200A"/>
                                                        <Setter Property="BorderBrush" Value="#7A5A14"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SeverityKind}" Value="major">
                                                                <Setter Property="Background" Value="#26170C"/>
                                                                <Setter Property="BorderBrush" Value="#8A4A1C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SeverityKind}" Value="crit">
                                                                <Setter Property="Background" Value="#261010"/>
                                                                <Setter Property="BorderBrush" Value="#8A1F1F"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding SeverityDisplay}" FontSize="10" FontWeight="Bold" Foreground="#F5B741"/>
                                            </Border>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                        <Setter Property="Padding" Value="7,2"/>
                                                        <Setter Property="Margin" Value="0"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Background" Value="#14532D"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateKind}" Value="nr">
                                                                <Setter Property="Background" Value="#7F1D1D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateKind}" Value="grey">
                                                                <Setter Property="Background" Value="#1A1E28"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StateDisplay}" FontSize="10" FontWeight="Bold" Foreground="#E5EDE8"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Desgaste por componente -->
                    <TextBlock Text="DESGASTE POR COMPONENTE — AUMENTO DE ESTA SESIÓN" Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/>
                    <Border Background="#0D0F14" BorderBrush="#1E2433" BorderThickness="1" CornerRadius="8" Padding="10,8"
                            Visibility="{Binding HasWearRows, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding WearRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding SystemName}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                            <TextBlock Text="{Binding AtaDisplay}" FontFamily="Consolas" FontSize="10" Foreground="#64748B" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DeltaDisplay}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="#22C55E" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TotalDisplay}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="#F1F5F9" TextAlignment="Right"/>
                                        <Border Grid.Column="3" Background="#1E2433" Height="6" CornerRadius="3" Margin="14,0">
                                            <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" Background="#3B82F6" Height="6" CornerRadius="3"/>
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="⚠ REQUIERE MANTENIMIENTO" FontSize="10" FontWeight="Bold"
                                                   Foreground="#F5B741" Visibility="{Binding RequiresMaintenance, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Text="Esta sesión no aplicó desgaste (sin ETA del OFP o sesión descartada)." FontSize="11"
                               Foreground="#64748B" Margin="0,2,0,0"
                               Visibility="{Binding HasWearRows, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="#1E2433" BorderThickness="0,1,0,0" Background="#0A0C10" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FooterButton}" Background="Transparent" BorderBrush="#2A2F3A"
                            Content="CERRAR" Click="Close_Click" Margin="0,0,10,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
