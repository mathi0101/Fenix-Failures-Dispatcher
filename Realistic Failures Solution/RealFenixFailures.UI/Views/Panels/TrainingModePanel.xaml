<UserControl x:Class="RealFenixFailures.UI.Views.Panels.TrainingModePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:RealFenixFailures.UI.ViewModels" d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
             xmlns:local="clr-namespace:RealFenixFailures.Domain.Enums;assembly=RealFenixFailures.Domain"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Tag Border Style: cambia background según Difficulty -->
        <Style x:Key="TagBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="#1A2A1A" />
            <!-- Borde sutil para separar contra el fondo oscuro -->
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#22000000" />
            <Style.Triggers>
                <!-- Si Difficulty es string -->
                <DataTrigger Binding="{Binding Difficulty}" Value="Easy">
                    <Setter Property="Background" Value="#1E7F3A" />
                    <!-- verde -->
                    <Setter Property="BorderBrush" Value="#331E7F3A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Difficulty}" Value="Medium">
                    <Setter Property="Background" Value="#C6A700" />
                    <!-- mostaza -->
                    <Setter Property="BorderBrush" Value="#33C6A700" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Difficulty}" Value="Hard">
                    <Setter Property="Background" Value="#D85A2A" />
                    <!-- naranja quemado -->
                    <Setter Property="BorderBrush" Value="#33D85A2A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Difficulty}" Value="Insane">
                    <Setter Property="Background" Value="#6F2DBD" />
                    <!-- violeta moderado -->
                    <Setter Property="BorderBrush" Value="#336F2DBD" />
                </DataTrigger>

                <!--
                Comentario: si Difficulty es enum, reemplaza los DataTrigger Value por:
                Value="{x:Static local:DifficultyEnum.Easy}"  etc.
                -->
            </Style.Triggers>
        </Style>

        <!-- Tag Text Style: por defecto texto oscuro, easy usa texto claro -->
        <Style x:Key="TagTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#0F1720" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Difficulty}" Value="Easy">
                    <!--<Setter Property="Foreground" Value="#FFFFFFFF" />-->
                    <Setter Property="Foreground" Value="#0F1720" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="MODO ENTRENAMIENTO" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource Brush.Accent.Blue.Primary}"/>
            <TextBlock Text="Seleccioná un escenario para practicar procedimientos de emergencia."
                       FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{Binding TrainingScenarios}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource ScenarioItemStyle}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     GroupName="TrainingScenario"
                                     Command="{Binding DataContext.SelectTrainingScenarioCommand,
                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     CommandParameter="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0">
                                        <!-- Difficulty tag: usa estilos definidos -->
                                        <Border Style="{StaticResource TagBorderStyle}" >
                                            <TextBlock Text="{Binding Difficulty}" Style="{StaticResource TagTextStyle}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text.Primary}" Margin="10,0"/>
                                        <!-- Phase tag  -->
                                        <Border Background="#1A2540" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Phase}" FontSize="10" Foreground="{StaticResource Brush.Accent.Blue.Primary}"/>
                                        </Border>
                                    </StackPanel>
                                    
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                       

                                       
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="▶" FontSize="14"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Border Background="{StaticResource Brush.Background.Glass.Inner}" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                    Visibility="{Binding HasSelectedTrainingScenario, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="ESCENARIO SELECCIONADO" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding SelectedTrainingScenario.Name}" FontSize="14"
                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedTrainingScenario.TriggerDescription}"
                               FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Button Content="{Binding TrainingStartText}"
                    Command="{Binding StartTrainingScenarioCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="40"
                    IsEnabled="{Binding CanStartTraining}"/>
        </StackPanel>
    </Grid>
</UserControl>