<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="RealFenixFailures.UI.Views.Panels.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RealFenixFailures.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SettingsWindowViewModel}"
             d:DesignWidth="780" d:DesignHeight="620"
             mc:Ignorable="d"
             Focusable="True">

    <UserControl.Resources>

        <!-- Converter nativo bool → Visible/Collapsed (para el botón de descarga y la barra de progreso) -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- TabItem: header limpio estilo píldora -->
        <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.MD}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="14,8"
                                Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{StaticResource Brush.Background.Card.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{StaticResource Brush.Background.Card.Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox oscuro -->
        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Brush.Background.Glass.Inner}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.MD}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent.Blue.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent.Blue.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón tipo link -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Blue.Primary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card contenedor de sección dentro de una pestaña -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Background.Glass.Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Background.TitleBar}"
                CornerRadius="12,12,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="4"
                            Background="#1E2433" Margin="0,0,10,0">
                        <TextBlock Text="⚙" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Accent.Blue.Primary}"/>
                    </Border>
                    <TextBlock Text="CONFIGURACIÓN" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="32" Height="32" Click="ClosePanel"
                        Style="{StaticResource GhostButtonStyle}" BorderThickness="0" FontSize="18"/>
            </Grid>
        </Border>

        <!-- CONTENIDO -->
        <TabControl x:Name="SettingsTabs"
                    Grid.Row="1"
                    Margin="20,16,20,20"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource SettingsTabItemStyle}">

            <!-- ============ GENERAL ============ -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>

                        <TextBlock Text="ID DE SIMBRIEF" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        <TextBox Text="{Binding SimbriefUserId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SettingsTextBoxStyle}"
                                 Width="320" HorizontalAlignment="Left"
                                 MaxLength="64"/>
                        <TextBlock Text="Es el nombre de usuario (alias) de tu cuenta en simbrief.com, tal cual figura en tu perfil. Con ese ID la app podrá descargar tu último plan de vuelo."
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   TextWrapping="Wrap" Width="460"
                                   HorizontalAlignment="Left" Margin="0,6,0,4"/>
                        <TextBlock Text="{Binding SaveStatusText}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Accent.Green.Primary}"
                                   Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SaveStatusText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Style="{StaticResource SettingsCardStyle}" Background="#1A2540">
                            <StackPanel>
                                <TextBlock Text="Privacidad" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="El ID se guarda solo en tu equipo (%AppData%\RealFenixFailures\userprefs.json) y solo se usa para consultar planes de vuelo públicos de SimBrief."
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <CheckBox IsChecked="{Binding TelemetryEnabled}" FontSize="11" Margin="0,10,0,0"
                                          HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                          Foreground="{StaticResource Brush.Text.Primary}"
                                          Content="Enviar estadísticas anónimas de uso"/>
                                <TextBlock Text="Estadísticas anónimas de uso: nos ayudan a mejorar la app en cada versión. Nunca incluyen datos de vuelo ni información personal. Podés apagarlo cuando quieras."
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,12">
                            <StackPanel>
                                <TextBlock Text="Logs y diagnósticos" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="Los logs diarios y los reportes individuales de errores (crash-*.log / error-*.log) están en esta carpeta." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,6"/>
                                <TextBlock Text="{Binding LogsDirectory}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,12"/>
                                <Button Content="Abrir carpeta de logs" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ AYUDA ============ -->
            <TabItem Header="Ayuda">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="GUÍA RÁPIDA" Style="{StaticResource SettingsSectionTitleStyle}"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="1. Preparar la cabina" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="Arrancá Microsoft Flight Simulator 2024 con el Fenix A320 y esperá a que la cabina esté lista."
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="2. Elegir un modo" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="Realista (fallas basadas en tu historial), Entrenamiento (escenarios preestablecidos) o Personalizado (control manual)."
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="3. Activar y volar" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="La app se refresca sola en todo momento: simulá con normalidad y reaccioná a las fallas como en un vuelo real."
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="4. Cerrar sesión" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="Cerrar la ventana minimiza al icono de la bandeja; la app sigue corriendo. Usá “Salir” desde la bandeja para terminar por completo."
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ DOCUMENTACIÓN ============ -->
            <TabItem Header="Documentación">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="DOCUMENTACIÓN" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Repositorio en GitHub" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="{Binding RepositoryUrl}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,12"/>
                                <Button Content="Abrir repositorio" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenRepositoryCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- ============ ACTUALIZACIONES ============ -->
            <TabItem x:Name="UpdatesTab" Header="Actualizaciones">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="VERSIÓN" Style="{StaticResource SettingsSectionTitleStyle}"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Versión instalada" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock FontSize="22" FontWeight="Bold" Margin="0,8,0,0"
                                           Foreground="{StaticResource Brush.Accent.Blue.Primary}">
                                    <Run Text="v"/><Run Text="{Binding AppVersion, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="El chequeo consulta las releases públicas del repositorio en GitHub. También muestra pre-releases: así podés enterarte de los builds de prueba apenas se publican."
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Button Content="Buscar actualizaciones"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding CheckForUpdatesCommand}"
                                        HorizontalAlignment="Left"/>

                                <!-- Indicador de búsqueda en curso -->
                                <ProgressBar Height="4" IsIndeterminate="True" Margin="0,10,0,0"
                                             Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BoolToVisConverter}}"/>

                                <!-- Resultado del chequeo -->
                                <TextBlock Text="{Binding UpdateStatusText}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static vm:UpdateCheckState.UpToDate}">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Green.Primary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static vm:UpdateCheckState.NewVersionAvailable}">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Amber.Primary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static vm:UpdateCheckState.NoReleases}">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static vm:UpdateCheckState.Error}">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Red.Primary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Acción cuando existe una versión más nueva -->
                                <Button Content="Descargar e ir a GitHub Releases"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding OpenReleasesCommand}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Visibility="{Binding HasNewUpdate, Converter={StaticResource BoolToVisConverter}}"/>

                                <TextBlock Text="La app no se actualiza sola: descargá el instalador desde GitHub Releases y reemplazá la versión actual."
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ REPORTAR UN FALLO ============ -->
            <TabItem Header="Reportar un fallo">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="REPORTAR UN FALLO" Style="{StaticResource SettingsSectionTitleStyle}"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="¿Encontraste un problema?" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="Abrí un issue en GitHub describiendo qué pasó, qué estabas haciendo y qué esperabas ver."
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Abrir Issues de GitHub"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding OpenIssuesCommand}"
                                HorizontalAlignment="Left"/>
                        <TextBlock Text="Consejo: adjuntá el log diario más reciente y el reporte individual (crash-*.log), si existe, junto con la versión que usás."
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   TextWrapping="Wrap" Width="520"
                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>

                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,12">
                            <StackPanel>
                                <TextBlock Text="Logs y diagnósticos" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="Los logs diarios y los reportes individuales de errores (crash-*.log / error-*.log) están en esta carpeta." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,6"/>
                                <TextBlock Text="{Binding LogsDirectory}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,12"/>
                                <Button Content="Abrir carpeta de logs" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ DONACIÓN ============ -->
            <TabItem Header="Donación">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="APOYAR EL DESARROLLO" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Ayudá a que el proyecto siga creciendo" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                                <TextBlock Text="Si disfrutás Real Fenix Failures, podés apoyar su desarrollo con una donación voluntaria. ¡Gracias por acompañar el proyecto!" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,10,0,10"/>
                                <TextBlock Text="{Binding DonationUrl}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <Button Content="Apoyar en Ko-fi" Style="{StaticResource DonationButtonStyle}" Command="{Binding OpenDonationCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
