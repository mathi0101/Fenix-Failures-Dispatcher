<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="RealFenixFailures.UI.Views.Panels.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RealFenixFailures.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RealFenixFailures.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SettingsWindowViewModel}"
             d:DesignWidth="780" d:DesignHeight="620"
             mc:Ignorable="d"
             Focusable="True">

    <UserControl.Resources>

        <!-- Converter nativo bool → Visible/Collapsed (para el botón de descarga y la barra de progreso) -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- TabItem: header limpio estilo píldora -->
        <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.MD}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="14,8"
                                Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{StaticResource Brush.Background.Card.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{StaticResource Brush.Background.Card.Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox oscuro -->
        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Brush.Background.Glass.Inner}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.MD}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent.Blue.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent.Blue.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón tipo link -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Blue.Primary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card contenedor de sección dentro de una pestaña -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Background.Glass.Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ComboBox oscuro compacto para Ajustes (mismo look que DarkComboBoxStyle del panel Realista) -->
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0A0C10"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="B"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"
                                                      ContentSource="SelectionBoxItem"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="▾" FontSize="10" Margin="8,0"
                                               Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#13161E" BorderBrush="{StaticResource Brush.Border.Default}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,4,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="H" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="H" Property="Background" Value="#1A2540"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="H" Property="Background" Value="#1A2540"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Background.TitleBar}"
                CornerRadius="12,12,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="4"
                            Background="#1E2433" Margin="0,0,10,0">
                        <TextBlock Text="⚙" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Accent.Blue.Primary}"/>
                    </Border>
                    <TextBlock Text="{loc:Loc Settings_Header}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="32" Height="32" Click="ClosePanel"
                        Style="{StaticResource GhostButtonStyle}" BorderThickness="0" FontSize="18"/>
            </Grid>
        </Border>

        <!-- CONTENIDO -->
        <TabControl x:Name="SettingsTabs"
                    Grid.Row="1"
                    Margin="20,16,20,20"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource SettingsTabItemStyle}">

            <!-- ============ GENERAL ============ -->
            <TabItem Header="{loc:Loc Settings_Tab_General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding SaveStatusText}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Accent.Green.Primary}"
                                   HorizontalAlignment="Right" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SaveStatusText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Idioma (issue #12) y SimBrief lado a lado: mejor uso del ancho -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Columna 1: Idioma (cambio en vivo, persistido en userprefs.json) -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc Settings_General_LanguageLabel}" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                                          MinWidth="190" HorizontalAlignment="Left"
                                          ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguageOption}"/>
                                <TextBlock Text="{loc:Loc Settings_General_LanguageHelp}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Columna 2: SimBrief -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Loc Settings_General_SimbriefLabel}" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                <TextBox Text="{Binding SimbriefUserId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextBoxStyle}"
                                         HorizontalAlignment="Stretch"
                                         MaxLength="64"/>
                                <TextBlock Text="{loc:Loc Settings_General_SimbriefHelp}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{loc:Loc Settings_PrivacyHelp}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource SettingsCardStyle}" Background="#1A2540" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings_PrivacyHeader}" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"/>
                                <CheckBox IsChecked="{Binding TelemetryEnabled}" FontSize="11" Margin="0,8,0,0"
                                          HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                          Foreground="{StaticResource Brush.Text.Primary}"
                                          Content="{loc:Loc Settings_TelemetryCheckbox}"/>
                                <TextBlock Text="{loc:Loc Settings_TelemetryHelp}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings_LogsHeader}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="{loc:Loc Settings_LogsHelp}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,6"/>
                                <TextBlock Text="{Binding LogsDirectory}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,12"/>
                                <Button Content="{loc:Loc Settings_OpenLogsFolder}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ MODO REALISTA (preferencias de usuario del modo) ============ -->
            <TabItem Header="{loc:Loc Settings_Tab_Realistic}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_RealisticHeader}" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        <Border Style="{StaticResource SettingsCardStyle}" Background="#1A2540">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings_RealisticGraceLabel}" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:Loc Settings_RealisticGraceHelp}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,6,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Input con unidad -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBox Text="{Binding RealisticCompletionGraceMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsTextBoxStyle}"
                                                 Width="72" MaxLength="3" HorizontalAlignment="Left"
                                                 VerticalContentAlignment="Center"/>
                                        <TextBlock Text="min" FontSize="12"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <!-- Presets rápidos -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Content="0" Command="{Binding SetRealisticGraceCommand}" CommandParameter="0"
                                                Style="{StaticResource GhostButtonStyle}" Width="34" Height="26" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Content="5" Command="{Binding SetRealisticGraceCommand}" CommandParameter="5"
                                                Style="{StaticResource GhostButtonStyle}" Width="34" Height="26" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Content="15" Command="{Binding SetRealisticGraceCommand}" CommandParameter="15"
                                                Style="{StaticResource GhostButtonStyle}" Width="34" Height="26" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Content="30" Command="{Binding SetRealisticGraceCommand}" CommandParameter="30"
                                                Style="{StaticResource GhostButtonStyle}" Width="34" Height="26" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ AYUDA + DOCUMENTACIÓN ============ -->
            <TabItem Header="{loc:Loc Settings_Tab_Help}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_HelpHeader}" Style="{StaticResource SettingsSectionTitleStyle}"/>

                        <!-- Guía rápida en grilla 2×2: aprovecha el ancho del panel -->
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,6,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Settings_Help1Title}" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Primary}"/>
                                    <TextBlock Text="{loc:Loc Settings_Help1Text}"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}" Margin="6,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Settings_Help2Title}" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Primary}"/>
                                    <TextBlock Text="{loc:Loc Settings_Help2Text}"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,6,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Settings_Help3Title}" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Primary}"/>
                                    <TextBlock Text="{loc:Loc Settings_Help3Text}"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}" Margin="6,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Settings_Help4Title}" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Primary}"/>
                                    <TextBlock Text="{loc:Loc Settings_Help4Text}"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Documentación (antes pestaña propia) -->
                        <TextBlock Text="{loc:Loc Settings_DocsHeader}" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,6,0,8"/>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings_DocsRepoLink}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="{Binding RepositoryUrl}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,12"/>
                                <Button Content="{loc:Loc Settings_OpenRepository}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenRepositoryCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- ============ ACTUALIZACIONES ============ -->
            <TabItem x:Name="UpdatesTab" Header="{loc:Loc Settings_Tab_Updates}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_UpdatesVersionLabel}" Style="{StaticResource SettingsSectionTitleStyle}"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings_InstalledVersion}" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock FontSize="22" FontWeight="Bold" Margin="0,8,0,0"
                                           Foreground="{StaticResource Brush.Accent.Blue.Primary}">
                                    <Run Text="v"/><Run Text="{Binding AppVersion, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings_UpdatesCheckHelp}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Button Content="{loc:Loc Settings_CheckUpdates}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding CheckForUpdatesCommand}"
                                        HorizontalAlignment="Left"/>

                                <!-- Indicador de búsqueda en curso -->
                                <ProgressBar Height="4" IsIndeterminate="True" Margin="0,10,0,0"
                                             Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BoolToVisConverter}}"/>

                                <!-- Resultado del chequeo -->
                                <TextBlock Text="{Binding UpdateStatusText}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static vm:UpdateCheckState.UpToDate}">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Green.Primary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static vm:UpdateCheckState.NewVersionAvailable}">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Amber.Primary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static vm:UpdateCheckState.NoReleases}">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static vm:UpdateCheckState.Error}">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Red.Primary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Acción cuando existe una versión más nueva -->
                                <Button Content="{loc:Loc Settings_DownloadGoToReleases}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding OpenReleasesCommand}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Visibility="{Binding HasNewUpdate, Converter={StaticResource BoolToVisConverter}}"/>

                                <TextBlock Text="{loc:Loc Settings_UpdatesManualInstall}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ REPORTAR UN FALLO ============ -->
            <TabItem Header="{loc:Loc Settings_Tab_ReportBug}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_BugHeader}" Style="{StaticResource SettingsSectionTitleStyle}"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings_BugQuestion}" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="{loc:Loc Settings_BugHelp}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="{loc:Loc Settings_OpenIssues}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding OpenIssuesCommand}"
                                HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:Loc Settings_BugTip}"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   TextWrapping="Wrap" Width="520"
                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>

                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings_LogsHeader}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="{loc:Loc Settings_LogsHelp}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,6"/>
                                <TextBlock Text="{Binding LogsDirectory}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,12"/>
                                <Button Content="{loc:Loc Settings_OpenLogsFolder}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ DONACIÓN ============ -->
            <TabItem Header="{loc:Loc Settings_Tab_Donate}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_DonateHeader}" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings_DonateTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:Loc Settings_DonateText}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,10,0,10"/>
                                <TextBlock Text="{Binding DonationUrl}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <Button Content="{loc:Loc Settings_DonateKofi}" Style="{StaticResource DonationButtonStyle}" Command="{Binding OpenDonationCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
