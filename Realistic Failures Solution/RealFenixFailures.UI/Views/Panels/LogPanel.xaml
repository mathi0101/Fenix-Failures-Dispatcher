<UserControl x:Class="RealFenixFailures.UI.Views.Panels.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:RealFenixFailures.UI.ViewModels" d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="260">

    <!-- LOG EN TIEMPO REAL — ahora ubicado en el panel izquierdo, debajo de los modos.
         Ocupa el espacio restante del panel izquierdo con scroll automático. -->
    <Border Background="{StaticResource Brush.Background.LogArea}"
            BorderBrush="{StaticResource Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- El área de log ocupa TODO el espacio restante del panel izquierdo -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="LOG EN TIEMPO REAL" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                <Border Background="#14532D" CornerRadius="10" Padding="8,2" Margin="10,0,0,0"
                        Visibility="{Binding IsEngineActive, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Accent.Green.Primary}"
                                 VerticalAlignment="Center" Margin="0,0,5,0">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1.0" To="0.25" Duration="0:0:0.8"
                                                             AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="ACTIVO" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Accent.Green.Primary}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          x:Name="LogScrollViewer"
                          ScrollChanged="LogScrollViewer_ScrollChanged">
                <ItemsControl ItemsSource="{Binding LogEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource LogEntryStyle}"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
